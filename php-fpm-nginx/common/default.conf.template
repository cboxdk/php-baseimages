# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  Cbox Base Image - Nginx Configuration Template                          ║
# ║  Production-ready with security hardening                                  ║
# ║  Variables substituted by envsubst at container startup                    ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Rate limiting zones (must be outside server block)
# Uncomment in nginx.conf or include globally if needed:
# limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
# limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
# limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;

# ─────────────────────────────────────────────────────────────────────────────
# Reverse Proxy / Tunnel Support (Cloudflare, HAProxy, Traefik, Tailscale)
# Configure via NGINX_TRUSTED_PROXIES environment variable
# ─────────────────────────────────────────────────────────────────────────────
${NGINX_REAL_IP_CONFIG}

# ─────────────────────────────────────────────────────────────────────────────
# Optional FastCGI upstream with connection pooling (NGINX_FASTCGI_KEEP_CONN=on)
# ─────────────────────────────────────────────────────────────────────────────
${NGINX_UPSTREAM_CONFIG}

# ─────────────────────────────────────────────────────────────────────────────
# Client-facing scheme/port behind a TLS-terminating proxy.
# Honor the upstream X-Forwarded-Proto/Port when present, else fall back to this
# server's own values. Without this, TLS terminated upstream (Traefik/Cloudflare/
# k8s ingress) is invisible to PHP → http:// URLs and a wrong $_SERVER['HTTPS'].
# (nginx variables here survive envsubst — it only substitutes the NGINX_* list.)
# ─────────────────────────────────────────────────────────────────────────────
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    "~.+"   $http_x_forwarded_proto;
}
# The port the CLIENT reached, which is not this server's own. $server_port is
# 80 in every one of these containers — TLS is terminated a hop earlier — so
# using it as the fallback told a trusting application it had been reached at
# `https://host:80`. The default now follows the forwarded scheme, and only an
# explicit X-Forwarded-Port overrides it.
map $forwarded_proto $scheme_default_port {
    https   443;
    default 80;
}
map $http_x_forwarded_port $forwarded_port {
    default $scheme_default_port;
    "~.+"   $http_x_forwarded_port;
}

# What HTTP_HOST must carry so a framework builds URLs somebody can click.
#
# Empty on the standard ports, which is every production deployment. On a
# development machine where the gateway is on 18443 because something else holds
# 443, a redirect to `https://app.cbox.test/login` goes to that something else —
# and Gateway API strips the port from :authority, so the application cannot see
# it any other way. It cannot come from X-Forwarded-Port alone either: that is
# only read from a proxy the framework trusts by IP, and real_ip has already
# replaced the proxy's address with the client's, so the trust never matches.
map "$forwarded_proto:$forwarded_port" $forwarded_host_port {
    "https:443" "";
    "http:80"   "";
    default     ":$forwarded_port";
}
map $forwarded_proto $forwarded_https {
    https   on;
    default "";
}

# ─────────────────────────────────────────────────────────────────────────────
# Access log format — NGINX_LOG_FORMAT: combined (default) | combined_no_query
# (privacy: query strings never hit disk) | json (structured, for log shippers)
# ─────────────────────────────────────────────────────────────────────────────
${NGINX_LOG_FORMAT_CONFIG}

# HTTP Server Block
server {
    listen ${NGINX_HTTP_PORT} ${NGINX_LISTEN_EXTRA};
    server_name _;
    root ${NGINX_WEBROOT};
    index ${NGINX_INDEX};

    # Client configuration
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    client_body_timeout ${NGINX_CLIENT_BODY_TIMEOUT};
    client_header_timeout ${NGINX_CLIENT_HEADER_TIMEOUT};

    # Hide Nginx version
    server_tokens ${NGINX_SERVER_TOKENS};

    # Server header rebrand/removal via headers-more module
    # (NGINX_SERVER_HEADER: custom value, or "none" to strip the header)
${NGINX_SERVER_HEADER_CONFIG}

    # ─────────────────────────────────────────────────────────────────────────
    # Security Headers (Modern Best Practices)
    # Generated dynamically - empty values are omitted
    # ─────────────────────────────────────────────────────────────────────────
${NGINX_SECURITY_HEADERS}

    # ─────────────────────────────────────────────────────────────────────────
    # Open File Cache (reduces file descriptor lookups)
    # Set NGINX_OPEN_FILE_CACHE=off to disable
    # ─────────────────────────────────────────────────────────────────────────
    open_file_cache ${NGINX_OPEN_FILE_CACHE};
    open_file_cache_valid ${NGINX_OPEN_FILE_CACHE_VALID};
    open_file_cache_min_uses ${NGINX_OPEN_FILE_CACHE_MIN_USES};
    open_file_cache_errors ${NGINX_OPEN_FILE_CACHE_ERRORS};

    # ─────────────────────────────────────────────────────────────────────────
    # Gzip Compression (3-5x smaller responses)
    # Set NGINX_GZIP=off to disable
    # ─────────────────────────────────────────────────────────────────────────
    gzip ${NGINX_GZIP};
    gzip_vary ${NGINX_GZIP_VARY};
    gzip_proxied ${NGINX_GZIP_PROXIED};
    gzip_comp_level ${NGINX_GZIP_COMP_LEVEL};
    gzip_min_length ${NGINX_GZIP_MIN_LENGTH};
    gzip_types ${NGINX_GZIP_TYPES};

    # Serve pre-compressed .gz files straight from disk when the build produced
    # them (Vite/Webpack/esbuild) — skips per-request compression entirely.
    # Falls back to dynamic gzip when no .gz file exists.
    gzip_static ${NGINX_GZIP_STATIC};

    # ─────────────────────────────────────────────────────────────────────────
    # Brotli Compression (15-20% smaller than gzip at the same CPU budget;
    # ngx_brotli module). Clients that support br get brotli, others gzip.
    # Set NGINX_BROTLI=off to disable
    # ─────────────────────────────────────────────────────────────────────────
    brotli ${NGINX_BROTLI};
    brotli_comp_level ${NGINX_BROTLI_COMP_LEVEL};
    brotli_types ${NGINX_BROTLI_TYPES};

    # Serve pre-compressed .br files straight from disk (mirrors gzip_static)
    brotli_static ${NGINX_BROTLI_STATIC};

    # Logging
    access_log ${NGINX_ACCESS_LOG};
    error_log ${NGINX_ERROR_LOG} ${NGINX_ERROR_LOG_LEVEL};

    # ─────────────────────────────────────────────────────────────────────────
    # Server-level extension point
    #
    # Drop a .conf file in /etc/nginx/server.d/ to add locations to THIS server
    # block without owning the whole template - an app needs exact-match or
    # named locations in front of PHP (a full-page cache, a redirect map, a
    # protected admin path), and the only way to get them used to be replacing
    # default.conf.template wholesale, which meant forking it and missing every
    # later fix to the health endpoints, security blocks and fastcgi params.
    # (http-level config already had conf.d/*.conf; this is the server level.)
    #
    # Position is deliberate: BEFORE the locations below, because nginx tries
    # regex locations in the order they appear, so a file here can take
    # precedence over the image's own. That also means a `location /` of your
    # own collides with the one below - use the Statamic preset or
    # NGINX_TRY_FILES for that instead. A bad file here fails `nginx -t` at
    # startup with its own filename and line number, not at 3am.
    # ─────────────────────────────────────────────────────────────────────────
    include /etc/nginx/server.d/*.conf;

    # ─────────────────────────────────────────────────────────────────────────
    # Main Location
    #
    # Rendered by the entrypoint: the plain try_files chain, or Statamic's
    # full static-caching chain when STATAMIC_STATIC_CACHING=full.
    # ─────────────────────────────────────────────────────────────────────────
${NGINX_MAIN_LOCATION}

    # ─────────────────────────────────────────────────────────────────────────
    # SECURITY: No PHP execution from user-upload trees
    # A file uploaded to Laravel's public disk (public/storage -> storage/app/
    # public) or WordPress uploads must never reach PHP-FPM - not even with a
    # trailing PATH_INFO twist like /storage/evil.php/x (hence the (/|$) anchor).
    # Regex locations match in order, so these MUST stay above the PHP block.
    # ─────────────────────────────────────────────────────────────────────────
    location ~* ^/storage/.*\.php(/|$) {
        deny all;
    }
    location ~* ^/wp-content/uploads/.*\.php(/|$) {
        deny all;
    }
    # public/vendor/ holds published package assets (see the directory block
    # near the end of this file), so the directory itself must stay reachable -
    # but nothing under it may ever execute.
    location ~* ^/vendor/.*\.php(/|$) {
        deny all;
    }

    # ─────────────────────────────────────────────────────────────────────────
    # PHP-FPM (with PATH_INFO support for Symfony/Laravel)
    # ─────────────────────────────────────────────────────────────────────────
    location ~ \.php$ {
        try_files $uri =404;

        # Split path info for framework routing (CRITICAL for Symfony)
        fastcgi_split_path_info ^(.+\.php)(/.+)$;

        # PHP-FPM connection
        fastcgi_pass ${NGINX_FASTCGI_PASS};
        fastcgi_keep_conn ${NGINX_FASTCGI_KEEP_CONN};
        fastcgi_index index.php;

        # PATH_INFO support (required for Symfony, some Laravel routes)
        fastcgi_param PATH_INFO $fastcgi_path_info;

        # The script root below is $realpath_root by default, $document_root
        # with NGINX_USE_REALPATH_ROOT=false. For a web root that contains no
        # symlinks the two are the same string; for a release-based deploy
        # (/app/current -> releases/<id>) only the first one is right. With
        # $document_root, PHP resolves every include through the symlink and
        # opcache - validate_timestamps=0 in production - keeps serving the
        # PREVIOUS release's compiled files until FPM is reloaded. Each request
        # now carries the release's real path, so the swap takes effect on it.
        # (Forge and Envoyer templates have used $realpath_root for years.)
        fastcgi_param PATH_TRANSLATED ${NGINX_SCRIPT_ROOT}$fastcgi_path_info;
        fastcgi_param SCRIPT_FILENAME ${NGINX_SCRIPT_ROOT}$fastcgi_script_name;
        include fastcgi_params;
        # DOCUMENT_ROOT has to come AFTER the include: fastcgi_params defines
        # it as $document_root, and of two definitions of one param the LAST
        # one reaches PHP. (The same reason the proxy headers below, HTTP_HOST
        # among them, sit after the include.)
        fastcgi_param DOCUMENT_ROOT ${NGINX_SCRIPT_ROOT};

        # ─────────────────────────────────────────────────────────────────────
        # Proxy Headers (forwarded to PHP for trusted proxy detection)
        # These enable Laravel TrustProxies, Symfony trusted_proxies, etc.
        # ─────────────────────────────────────────────────────────────────────
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_PROTO $forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_HOST $host;
        fastcgi_param HTTP_X_FORWARDED_PORT $forwarded_port;
        fastcgi_param HTTP_HOST $host$forwarded_host_port;
        # Set HTTPS so PHP's $_SERVER['HTTPS'] is correct when TLS is terminated
        # here OR upstream (empty string when not https — PHP treats it as off).
        fastcgi_param HTTPS $forwarded_https;
        fastcgi_param HTTP_X_REAL_IP $remote_addr;

        # mTLS client certificate info (available when MTLS_ENABLED=true)
        # Use in PHP: $_SERVER['SSL_CLIENT_VERIFY'], $_SERVER['SSL_CLIENT_S_DN']
        fastcgi_param SSL_CLIENT_VERIFY $ssl_client_verify;
        fastcgi_param SSL_CLIENT_S_DN $ssl_client_s_dn;
        fastcgi_param SSL_CLIENT_I_DN $ssl_client_i_dn;
        fastcgi_param SSL_CLIENT_SERIAL $ssl_client_serial;
        fastcgi_param SSL_CLIENT_FINGERPRINT $ssl_client_fingerprint;

        # FastCGI buffering
        fastcgi_buffers ${NGINX_FASTCGI_BUFFERS};
        fastcgi_buffer_size ${NGINX_FASTCGI_BUFFER_SIZE};
        fastcgi_busy_buffers_size ${NGINX_FASTCGI_BUSY_BUFFERS_SIZE};

        # FastCGI timeouts
        fastcgi_connect_timeout ${NGINX_FASTCGI_CONNECT_TIMEOUT};
        fastcgi_send_timeout ${NGINX_FASTCGI_SEND_TIMEOUT};
        fastcgi_read_timeout ${NGINX_FASTCGI_READ_TIMEOUT};

        # Hide PHP version
        fastcgi_hide_header X-Powered-By;
    }

    # ─────────────────────────────────────────────────────────────────────────
    # Rate Limited Endpoints (uncomment if rate limit zones defined)
    # ─────────────────────────────────────────────────────────────────────────
    # location /login {
    #     limit_req zone=login burst=5 nodelay;
    #     try_files $uri $uri/ /index.php?$query_string;
    # }
    #
    # location /api {
    #     limit_req zone=api burst=50;
    #     try_files $uri $uri/ /index.php?$query_string;
    # }

    # ─────────────────────────────────────────────────────────────────────────
    # Internal nginx liveness — for cbox-init's own nginx process check ONLY
    # (localhost). The base image must NOT shadow app-facing routes: /health and
    # /up belong to the application and fall through to it. Kubernetes readiness
    # should probe cbox-init's supervisor signal instead:
    #   readinessProbe: { exec: { command: ["test","-f","/tmp/cbox-ready"] } }
    # ─────────────────────────────────────────────────────────────────────────
    location = /healthz {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # PHP-FPM status (localhost only)
    location ~ ^/(fpm-status|fpm-ping)$ {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        access_log off;
        fastcgi_pass ${NGINX_FASTCGI_PASS};
        fastcgi_keep_conn ${NGINX_FASTCGI_KEEP_CONN};
        fastcgi_param SCRIPT_FILENAME ${NGINX_SCRIPT_ROOT}$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_param DOCUMENT_ROOT ${NGINX_SCRIPT_ROOT};
    }

    # ─────────────────────────────────────────────────────────────────────────
    # Static files with caching
    # Falls back to PHP if file doesn't exist (for Livewire, Vite, etc.)
    # ─────────────────────────────────────────────────────────────────────────
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|webp|avif)$ {
        # If static file exists, serve it; otherwise fall back to PHP (Livewire, etc.)
        try_files $uri ${NGINX_TRY_FILES};
        expires ${NGINX_STATIC_EXPIRES};
        add_header Cache-Control "${NGINX_STATIC_CACHE_CONTROL}";
        # nginx add_header does NOT inherit across levels: adding Cache-Control here
        # drops all server-level security headers, so re-emit them on static assets.
${NGINX_SECURITY_HEADERS}
        access_log ${NGINX_STATIC_ACCESS_LOG};

        # Prevent execution of PHP in static locations
        location ~ \.php$ {
            deny all;
        }
    }

    # ─────────────────────────────────────────────────────────────────────────
    # SECURITY: Block sensitive files and directories
    # ─────────────────────────────────────────────────────────────────────────

    # RFC 8615 — /.well-known/ is the reserved namespace for site-wide
    # service metadata: OIDC discovery, OAuth authorization-server
    # metadata, security.txt, ACME challenges, change-password, etc.
    # Apps register handlers (e.g. Laravel: `Route::get('.well-known/...')`),
    # but the catch-all dotfile block below would otherwise 404 every
    # request before the app sees it.
    #
    # `^~` makes this a prefix match that wins over the regex catch-all
    # below — nginx prefers `^~` matches and skips regex evaluation
    # when one matches. Place BEFORE the `/\.` block; ordering of
    # regex blocks matters but `^~` short-circuits regardless.
    location ^~ /.well-known/ {
        try_files $uri $uri/ ${NGINX_TRY_FILES};
    }

    # Block hidden files (.env, .git, .htaccess, .svn, etc.)
    location ~ /\.(env|git|svn|htaccess|htpasswd|gitignore|gitattributes|dockerignore) {
        deny all;
        return 404;
    }

    # Block all other hidden files
    location ~ /\. {
        deny all;
        return 404;
    }

    # Block sensitive project files (in root or subdirectories)
    location ~* ^/(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|Dockerfile|docker-compose\.ya?ml|Makefile|Vagrantfile|\.editorconfig|phpunit\.xml|phpstan\.neon|psalm\.xml)$ {
        deny all;
        return 404;
    }

    # Block sensitive directories.
    #
    # vendor/ is NOT in this list, and must not be: the web root is public/, so
    # /vendor/ here means public/vendor/ - exactly where Laravel packages
    # publish their browser assets. Denying the directory 404'd every one of
    # them, which is the Statamic Control Panel
    # (public/vendor/statamic/cp/...), the Horizon dashboard
    # (public/vendor/horizon/...) and anything else installed with
    # `vendor:publish --tag=*-assets`. The project's real vendor/ is outside
    # the web root anyway; what this rule was actually protecting against is
    # NGINX_WEBROOT pointed at the project root by mistake, and for that it is
    # PHP execution that matters - denied above, next to the storage/ rules,
    # where it has to sit to win over the `\.php$` block.
    #
    # The rest have no legitimate place under a web root at all.
    location ~ ^/(node_modules|storage/logs|storage/debugbar|tests|\.github|\.vscode|\.idea)/ {
        deny all;
        return 404;
    }

    # Block PHP files in upload directories (prevent malicious uploads)
    location ~* /(?:uploads|files|media)/.*\.php$ {
        deny all;
        return 404;
    }

    # Block access to artisan (Laravel CLI)
    location = /artisan {
        deny all;
        return 404;
    }

    # Block database and backup files
    location ~* \.(sql|bak|old|backup|swp|db|sqlite)$ {
        deny all;
        return 404;
    }
}
