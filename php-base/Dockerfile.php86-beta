# ============================================================================
# EXPERIMENTAL: PHP 8.6 beta lane, all four tiers (issue #23)
# ============================================================================
# Purpose: build slim/standard/chromium/dev against php:8.6-rc TODAY so the
# pecl-free (PIE) path and every extension's 8.6-readiness is measured, not
# guessed. Extensions known to be blocked are still ATTEMPTED, tolerantly:
# a failure lands in /usr/local/etc/php86-report.txt instead of killing the
# build, and the day upstream tags an 8.6 fix the report flips to OK on the
# next weekly run - the lane discovers it before we do.
#
# This file converges into php-base/Dockerfile at 8.6 GA, then dies.
#
# Facts this lane established (2026-09-14/15, 8.6.0beta2):
# - `pecl` does not exist in 8.6 images; the stable `pie` binary refuses to
#   RUN on 8.6 - nightly-bin required until a stable pie admits 8.6
# - `mbstring` must be installed explicitly (+libonig)
# - 8.6's gd links libwebpdemux/libwebpmux: add libwebpdemux2 libwebpmux3
# - beta2 is still NTS (keep watching the ZTS default flip)
# Deliberately absent: vips (pecl ext dead; php-vips 2.x is userland FFI -
# architecture decision pending), Bun and the gd-AVIF rebuild (not what this
# lane measures; both return at GA convergence).
# ============================================================================

ARG PHP_VERSION=8.6-rc

# ────────────────────────────────────────────────────────────────────────────
# SLIM
# ────────────────────────────────────────────────────────────────────────────
FROM php:${PHP_VERSION}-cli-bookworm AS beta-slim

ARG CACHE_REFRESH=local

# telemetry-native pin (mirrors extensions.telemetry_native in versions.json;
# this lane hardcodes its pins the same way SPX and Node do below)
ARG TELEMETRY_NATIVE_VERSION=0.1.0

RUN echo "cache-refresh=${CACHE_REFRESH}" >/dev/null && \
    apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.title="Cbox PHP Base 8.6 BETA (experimental)"
LABEL org.opencontainers.image.description="PHP 8.6 pre-GA lane: pecl-free installs via PIE - NOT for production"
LABEL org.opencontainers.image.source="https://github.com/cboxdk/php-baseimages"

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl wget git unzip procps openssh-client \
    cron \
    libpng16-16 libjpeg62-turbo libfreetype6 libwebp7 libwebpdemux2 libwebpmux3 \
    libpq5 libicu72 libzip4 \
    libxml2 \
    libbz2-1.0 libonig5 libreadline8 libgmp10 \
    && rm -rf /var/lib/apt/lists/*

RUN git config --system --add safe.directory '*'

# Core extensions from php-src: the early-warning system for C-API breakage.
# mbstring is EXPLICIT on 8.6; opcache is built in - no explicit install.
RUN apt-get update && apt-get install -y --no-install-recommends \
    $PHPIZE_DEPS \
    libpng-dev libjpeg62-turbo-dev libfreetype6-dev libwebp-dev \
    libpq-dev libicu-dev libzip-dev \
    libbz2-dev libonig-dev libreadline-dev libgmp-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_mysql pdo_pgsql mysqli pgsql \
        zip intl bcmath gd exif \
        pcntl sockets bz2 gmp \
        mbstring \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \
        libpng-dev libjpeg62-turbo-dev libfreetype6-dev libwebp-dev \
        libpq-dev libicu-dev libzip-dev \
        libbz2-dev libonig-dev libreadline-dev libgmp-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# The attempt harness: every PIE install below is tolerated and scored.
# UNPINNED on purpose - the lane exists to notice upstream movement. A
# failed install must not leave a dangling ini enabling a missing .so.
COPY <<'EOF' /usr/local/bin/pie-attempt
#!/bin/sh
# usage: pie-attempt <ext-name> <vendor/package[:version|:dev-branch]> [-DEV]
# -DEV marks a development-branch attempt: it is skipped when the released
# version already loaded, and scores as OK-DEV/FAIL-DEV so the scoreboard
# separates "released and working" from "fix confirmed on branch, await tag".
name="$1"; pkg="$2"; label="${3:-}"; REPORT=/usr/local/etc/php86-report.txt
if [ "$label" = "-DEV" ] && php -m 2>/dev/null | grep -qix "$name"; then
    echo "SKIP-DEV $name  (released version already loaded)" >> "$REPORT"
    exit 0
fi
if pie install "$pkg" >"/tmp/pie-$name.log" 2>&1; then
    v=$(php -r "echo phpversion('$name');" 2>/dev/null)
    echo "OK$label   $name  $pkg  $v" >> "$REPORT"
else
    rm -f /usr/local/etc/php/conf.d/*"$name"*.ini
    reason=$(grep -iE 'cannot use|not compatible|requires php|fatal error|error:|exit code' "/tmp/pie-$name.log" | head -1)
    [ -n "$reason" ] || reason=$(grep -vE '^\s*$|^ *\[|Output:|^install \[' "/tmp/pie-$name.log" | tail -1)
    echo "FAIL$label $name  $pkg  $(echo "$reason" | cut -c1-140)" >> "$REPORT"
fi
exit 0
EOF
RUN chmod +x /usr/local/bin/pie-attempt && \
    printf '# PHP 8.6 beta lane extension report (%s)\n' "$(date -u +%F)" > /usr/local/etc/php86-report.txt

# Slim-tier PECL successors: redis/apcu/msgpack are the known blockers -
# attempted every build so the report flips the week upstream tags fixes.
RUN --mount=type=bind,from=ghcr.io/php/pie:nightly-bin,source=/pie,target=/usr/local/bin/pie \
    apt-get update && apt-get install -y --no-install-recommends $PHPIZE_DEPS \
    && pie-attempt redis phpredis/phpredis \
    && pie-attempt apcu apcu/apcu \
    && pie-attempt msgpack msgpack/msgpack-php \
    # dev-branch fallbacks: the 8.6 fixes are MERGED upstream but untagged -
    # Packagist syncs the branches, so PIE can build them. Auto-retired: the
    # -DEV attempt skips itself once the released attempt above succeeds.
    && pie-attempt redis phpredis/phpredis:dev-develop -DEV \
    && pie-attempt apcu apcu/apcu:dev-master -DEV \
    && pie-attempt msgpack msgpack/msgpack-php:dev-master -DEV \
    # telemetry-native ships in production from slim up, built from a pinned
    # source tag and gated off. It declares ^8.3|^8.4|^8.5, so whether it
    # survives 8.6 is exactly the kind of question this report exists to
    # answer. Same gate as production: the ini stays out of the scan dir.
    && ( git clone --depth=1 --branch "v${TELEMETRY_NATIVE_VERSION}" https://github.com/cboxdk/telemetry-native.git /tmp/telemetry-native \
         && cd /tmp/telemetry-native && phpize >/dev/null && ./configure --enable-cbox-telemetry >/dev/null \
         && make -j"$(nproc)" >/tmp/tn.log 2>&1 && make install >/dev/null \
         && mkdir -p /usr/local/etc/php/conf.d-telemetry /usr/local/etc/php/conf.d-telemetry-auto \
         && printf 'extension=cbox_telemetry.so\n' > /usr/local/etc/php/conf.d-telemetry/cbox-telemetry.ini \
         && printf 'cbox_telemetry.auto=1\n' > /usr/local/etc/php/conf.d-telemetry-auto/cbox-telemetry-auto.ini \
         && echo "OK   cbox_telemetry  source:v${TELEMETRY_NATIVE_VERSION}  $(php -d extension=cbox_telemetry.so -r "echo cbox_telemetry_status()['timer_backend'];") (opt-in, not loaded)" >> /usr/local/etc/php86-report.txt \
         || echo "FAIL cbox_telemetry  source:v${TELEMETRY_NATIVE_VERSION}  $(grep -iE 'error' /tmp/tn.log 2>/dev/null | head -1 | cut -c1-140)" >> /usr/local/etc/php86-report.txt ) \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY php-base/common/php.ini /usr/local/etc/php/php.ini

# ────────────────────────────────────────────────────────────────────────────
# STANDARD: + built-in extras, imagick attempt, mongodb/otel via PIE, Node
# ────────────────────────────────────────────────────────────────────────────
FROM beta-slim AS beta-standard

# Built-in extras (php-src): discover that each still compiles on 8.6.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxslt1.1 libldap-2.5-0 \
    $PHPIZE_DEPS libxml2-dev libxslt1-dev libldap2-dev \
    && docker-php-ext-install -j"$(nproc)" \
        soap xsl ldap calendar gettext shmop sysvmsg sysvsem sysvshm \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS libxml2-dev libxslt1-dev libldap2-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# PECL successors for the standard tier. imagick is a known blocker
# (attempted); mongodb + otel are the two with real 8.6 support today.
RUN --mount=type=bind,from=ghcr.io/php/pie:nightly-bin,source=/pie,target=/usr/local/bin/pie \
    apt-get update && apt-get install -y --no-install-recommends $PHPIZE_DEPS libmagickwand-dev \
    && pie-attempt imagick imagick/imagick \
    && pie-attempt imagick imagick/imagick:dev-master -DEV \
    && pie-attempt mongodb mongodb/mongodb-extension \
    && pie-attempt opentelemetry open-telemetry/ext-opentelemetry \
    # otel stays opt-in exactly like production (observer tax, -18.5% Laravel)
    && mkdir -p /usr/local/etc/php/conf.d-otel \
    && for f in /usr/local/etc/php/conf.d/*opentelemetry*.ini; do \
         [ -e "$f" ] && mv "$f" /usr/local/etc/php/conf.d-otel/; \
       done \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS libmagickwand-dev \
    && apt-get update && apt-get install -y --no-install-recommends libmagickwand-6.q16-6 \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Node.js for the chromium tier's Playwright story (same major as production)
ARG NODE_VERSION=22.23.1
RUN ARCH=$(dpkg --print-architecture) && case "$ARCH" in amd64) NARCH=x64;; arm64) NARCH=arm64;; *) exit 1;; esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NARCH}.tar.gz" \
       | tar -xz -C /usr/local --strip-components=1 \
    && node -v && npm -v

# ────────────────────────────────────────────────────────────────────────────
# CHROMIUM: + browser stack (PHP-version-independent, should just work)
# ────────────────────────────────────────────────────────────────────────────
FROM beta-standard AS beta-chromium

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium chromium-driver \
    fonts-noto-color-emoji fonts-unifont fonts-freefont-ttf fonts-liberation \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxrandr2 libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN npm install -g playwright@latest \
    && playwright install chromium \
    && chmod -R a+rX /ms-playwright \
    && npm uninstall -g playwright \
    && npm cache clean --force

# ────────────────────────────────────────────────────────────────────────────
# DEV: + xdebug (alpha attempt), pcov (blocked attempt), SPX (source attempt)
# ────────────────────────────────────────────────────────────────────────────
FROM beta-chromium AS beta-dev

ARG SPX_VERSION=v0.4.22
RUN --mount=type=bind,from=ghcr.io/php/pie:nightly-bin,source=/pie,target=/usr/local/bin/pie \
    apt-get update && apt-get install -y --no-install-recommends $PHPIZE_DEPS zlib1g-dev \
    # xdebug stable (3.5.x) excludes 8.6; the alpha is the only candidate.
    # Attempting latest means the report flips when 3.6.0 stable tags.
    && pie-attempt xdebug xdebug/xdebug \
    && pie-attempt xdebug xdebug/xdebug:3.6.0alpha1 -DEV \
    && pie-attempt pcov pecl/pcov \
    # pcov's 8.6 fix lives on an UNMERGED branch (krakjoe/pcov#133)
    && pie-attempt pcov pecl/pcov:dev-issue-php86a2 -DEV \
    # SPX comes from source (never was on PECL) - does it phpize on 8.6?
    && ( git clone --depth=1 --branch "$SPX_VERSION" https://github.com/NoiseByNorthwest/php-spx.git /tmp/php-spx \
         && cd /tmp/php-spx && phpize >/dev/null && ./configure >/dev/null && make -j"$(nproc)" >/tmp/spx.log 2>&1 \
         && make install >/dev/null && docker-php-ext-enable spx \
         && echo "OK   spx  source:$SPX_VERSION  $(php -r "echo phpversion('spx');")" >> /usr/local/etc/php86-report.txt \
         || { rm -f /usr/local/etc/php/conf.d/*spx*.ini; \
              echo "FAIL spx  source:$SPX_VERSION  $(grep -iE 'error' /tmp/spx.log 2>/dev/null | head -1 | cut -c1-140)" >> /usr/local/etc/php86-report.txt; } ) \
    # SPX dev fallback: same skip-once-released logic as the PIE -DEV attempts
    && ( php -m | grep -qi "^spx$" || { \
         rm -rf /tmp/php-spx && git clone --depth=1 https://github.com/NoiseByNorthwest/php-spx.git /tmp/php-spx \
         && cd /tmp/php-spx && phpize >/dev/null && ./configure >/dev/null && make -j"$(nproc)" >/tmp/spx-dev.log 2>&1 \
         && make install >/dev/null && docker-php-ext-enable spx \
         && echo "OK-DEV   spx  source:master  $(php -r "echo phpversion('spx');")" >> /usr/local/etc/php86-report.txt \
         || { rm -f /usr/local/etc/php/conf.d/*spx*.ini; \
              echo "FAIL-DEV spx  source:master  $(grep -iE 'error' /tmp/spx-dev.log 2>/dev/null | head -1 | cut -c1-140)" >> /usr/local/etc/php86-report.txt; }; } ) \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# If xdebug made it in, it must not tax every request by default: same
# philosophy as production (mode off; XDEBUG_MODE overrides at runtime).
RUN if php -m 2>/dev/null | grep -qi xdebug; then \
        ini=$(ls /usr/local/etc/php/conf.d/*xdebug*.ini 2>/dev/null | head -1) && \
        printf 'xdebug.mode=off\n' >> "$ini"; \
    fi
